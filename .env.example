# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# GitHub fine-grained token, read-only: Metadata, Contents, Issues, Pull requests.
# Issues: read & write only if you use --publish.
GITHUB_TOKEN=

# Comma-separated repositories to analyse
RADAR_REPOS=owner/repo-one,owner/repo-two

# Optional
RADAR_SINCE_DAYS=7
RADAR_MODEL=claude-sonnet-5
# RADAR_OUT_DIR=./reports
# GITHUB_API_URL=https://api.github.com
