{
  "name": "delivery-radar",
  "version": "0.1.0",
  "description": "AI agent for Delivery Managers: evidence-based weekly status, RAID log and estimation insights from GitHub repositories.",
  "type": "module",
  "bin": {
    "delivery-radar": "src/cli.js"
  },
  "scripts": {
